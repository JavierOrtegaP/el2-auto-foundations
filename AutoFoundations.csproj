<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional, not committed: <Project><PropertyGroup><GameDir>D:\...\ENDLESS Legend 2</GameDir></PropertyGroup></Project> -->
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <AssemblyName>AutoFoundations</AssemblyName>
    <RootNamespace>AutoFoundations</RootNamespace>
    <!-- The one place to bump the version: also the BepInEx plugin version and the release zip name. -->
    <Version>1.0.0</Version>
    <!-- ENDLESS Legend 2 runs Unity 6 on Mono with the .NET 4.x profile. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;.cache/**;dist/**</DefaultItemExcludes>

    <!-- The game: local.props, the EL2_GAME_DIR environment variable, `dotnet build -p:GameDir=...`, or Steam's default. -->
    <GameDir Condition="'$(GameDir)' == ''">$(EL2_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ENDLESS Legend 2</GameDir>
    <ManagedDir>$(GameDir)\Endless Legend 2_Data\Managed</ManagedDir>
    <!-- Compile against the game's BepInEx if installed, else a copy unpacked into .cache/bepinex. -->
    <BepInExCoreDir Condition="Exists('$(GameDir)\BepInEx\core\BepInEx.dll')">$(GameDir)\BepInEx\core</BepInExCoreDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(MSBuildProjectDirectory)\.cache\bepinex\BepInEx\core</BepInExCoreDir>
    <PluginDeployDir>$(GameDir)\BepInEx\plugins\AutoFoundations</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Compiles against a copy of Firstpass with internals made public; Mono does not enforce access checks at runtime. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Everything below is loaded by the game at runtime; never copy it to the output. -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" />

    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDir)\Newtonsoft.Json.dll" />
    <Reference Include="Sirenix.Serialization" HintPath="$(ManagedDir)\Sirenix.Serialization.dll" />

    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" />
    <Reference Include="Amplitude.Mercury.Firstpass" HintPath="$(ManagedDir)\Amplitude.Mercury.Firstpass.dll" Publicize="true" />
    <Reference Include="$(ManagedDir)\Amplitude*.dll" Exclude="$(ManagedDir)\Amplitude.Mercury.Firstpass.dll" />
  </ItemGroup>

  <!-- Plugin.Version for [BepInPlugin], from <Version> above. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace AutoFoundations { internal static class BuildInfo { public const string Version = &quot;$(Version)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Copies the build into the game when BepInEx is installed there (skip with -p:SkipDeploy=true). A running game keeps
       the version it started with; the copy is picked up on its next launch. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\core\BepInEx.dll') And '$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(PluginDeployDir)" />
  </Target>

  <!-- Release builds also write dist/AutoFoundations-<version>.zip, laid out to extract into the game folder. -->
  <Target Name="Package" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <StageDir>$(BaseIntermediateOutputPath)package/</StageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetPath);README.md;LICENSE;CHANGELOG.md" DestinationFolder="$(StageDir)BepInEx/plugins/AutoFoundations" />
    <MakeDir Directories="dist" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="dist/AutoFoundations-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Packaged dist/AutoFoundations-$(Version).zip" />
  </Target>

</Project>
